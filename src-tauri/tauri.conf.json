{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "avtonarezka",
  "version": "0.4.2",
  "identifier": "app.avtonarezka.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Автонарезка",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Video",
    "shortDescription": "Локальная фабрика вертикальных роликов",
    "longDescription": "Объединяет источники, локальный анализ, шаблоны монтажа, одобрение, кампании и календарь публикаций. Сохраняет ручную Студию и восстанавливает очередь после перезапуска.",
    "copyright": "© Автонарезка",
    "externalBin": [
      "binaries/llm-worker"
    ],
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "libsecret-tools",
          "xdg-utils",
          "libvulkan1"
        ],
        "recommends": [
          "chromium",
          "yt-dlp",
          "libayatana-appindicator3-1"
        ],
        "desktopTemplate": "packaging/avtonarezka.desktop"
      }
    }
  },
  "mainBinaryName": "avtonarezka"
}
