# Сборка безголового демона под Ubuntu 24.04 (glibc 2.39), чтобы он запускался на сервере.
# Образ и тулчейн Rust скачиваются при первой сборке; build.sh спрашивает согласие.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential pkg-config ca-certificates curl cmake clang libssl-dev \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
WORKDIR /src
